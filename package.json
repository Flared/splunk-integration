{
  "name": "@splunk/splunk-create-monorepo",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build": "yarn workspaces run build",
    "format": "yarn format:python && yarn format:prettier",
    "format:verify": "yarn format:python:verify && yarn format:prettier:verify",
    "format:prettier": "prettier --write .",
    "format:prettier:verify": "prettier --check .",
    "format:python": "node scripts/format-python.cjs",
    "format:python:verify": "node scripts/format-python.cjs --check",
    "lint": "yarn workspaces run lint",
    "setup": "yarn && yarn build",
    "test": "yarn workspaces run test",
    "start": "yarn workspace @splunk/flare run start"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  }
}
