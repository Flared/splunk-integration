{
  "name": "@splunk/splunk-create-monorepo",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "format": "pnpm format:python && pnpm format:prettier",
    "format:verify": "pnpm format:python:verify && pnpm format:prettier:verify",
    "format:prettier": "prettier --write .",
    "format:prettier:verify": "prettier --check .",
    "format:python": "node scripts/format-python.cjs",
    "format:python:verify": "node scripts/format-python.cjs --check",
    "lint": "pnpm -r lint",
    "setup": "pnpm install && pnpm run build",
    "test": "pnpm -r test",
    "start": "pnpm --filter @splunk/flare run start"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": ">=22"
  }
}
